{
  "name": "songsmith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Unlicense",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "postinstall": "node scripts/fetch-cmudict.mjs",
    "fetch:cmudict": "node scripts/fetch-cmudict.mjs",
    "dev": "tsx --experimental-sqlite --watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external && cp src/schema.sql dist/schema.sql",
    "start": "node --experimental-sqlite dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "build:all": "npm run build:web && npm run build"
  },
  "dependencies": {
    "@fastify/static": "10.1.2",
    "fastify": "5.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "5.8.3"
  }
}
