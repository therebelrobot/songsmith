{
  "name": "songsmith-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Unlicense",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --force",
    "test": "tsx --test src/*.test.ts",
    "smoke": "esbuild smoke.tsx --bundle --platform=node --format=cjs --outfile=node_modules/.smoke.cjs --jsx=automatic --log-level=error && node node_modules/.smoke.cjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tonal": "6.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "tsx": "^4.23.1",
    "typescript": "5.8.3",
    "vite": "7.1.9"
  }
}
